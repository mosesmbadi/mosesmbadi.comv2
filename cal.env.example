# -------------------------------------------------------
# Cal.com self-hosted environment variables
# Copy this file to cal.env and fill in the values.
# cal.env is gitignored — never commit secrets.
# -------------------------------------------------------

# PostgreSQL — matches the postgres service in docker-compose
DATABASE_URL=postgresql://calcom:calcom@postgres:5432/calcom
DATABASE_DIRECT_URL=postgresql://calcom:calcom@postgres:5432/calcom

# The public URL the browser uses to reach Cal.com
# Local dev:  http://localhost:3000
# Production: https://cal.yourdomain.com
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3000


# Random secrets — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret
CALENDSO_ENCRYPTION_KEY=replace-with-a-32-char-secret!!

# ---- Email (required for booking confirmations) --------
EMAIL_FROM=noreply@yourdomain.com
EMAIL_SERVER_HOST=smtp.yourdomain.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-smtp-user
EMAIL_SERVER_PASSWORD=your-smtp-password

# ---- Optional: disable sign-ups so only you can log in --
# NEXT_PUBLIC_DISABLE_SIGNUP=true


ADMIN_USERNAME=moses
ADMIN_PASSWORD=password
JWT_SECRET=replace-with-a-random-secret